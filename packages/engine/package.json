{
  "name": "@huecraft/engine",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench": "vitest run --root ../.. --mode bench",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@huecraft/exporters": "workspace:*",
    "@huecraft/filament-db": "workspace:*",
    "@huecraft/image-core": "workspace:*",
    "@huecraft/mesh": "workspace:*",
    "@huecraft/optics": "workspace:*",
    "@huecraft/project-schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
